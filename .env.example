# =============================================================================
# Variables para el deploy con docker-compose.yml (Dokploy > pestaña Environment).
# Copiá esto en Dokploy y completá los valores reales. NO lo subas con secretos.
# =============================================================================

# --- Base de datos (el servicio 'db' del compose la crea con estos valores) ---
POSTGRES_USER=qpass
POSTGRES_PASSWORD=cambia-esto-por-una-clave-fuerte
POSTGRES_DB=qpass

# --- Backend ---
# Mínimo 16 caracteres. Generá uno aleatorio, ej: openssl rand -base64 32
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRA_EN=8h

# URL pública del FRONTEND (para CORS). Sin barra final.
CORS_ORIGEN=https://qpass.tudominio.com

# SMTP: opcional (hoy MailService solo loguea). Dejar vacío si no se usa.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Frontend (build-time) ---
# URL pública del BACKEND. Vite la hornea en el bundle al compilar: si cambia,
# hay que reconstruir el frontend. Sin barra final.
VITE_API_URL=https://api.qpass.tudominio.com
