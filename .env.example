# =============================================================================
# Variables para el deploy con docker-compose.yml (Dokploy > pestaña Environment).
# Copiá esto en Dokploy y completá los valores reales. NO lo subas con secretos.
#
# UN SOLO DOMINIO: el frontend sirve la app y hace de proxy del API en /api.
# No hace falta subdominio para el backend ni configurar CORS.
# =============================================================================

# --- Base de datos (el servicio 'db' del compose la crea con estos valores) ---
# OJO: si ya desplegaste antes, Postgres se queda con la contraseña vieja del
# volumen. Si cambiás esto, borrá el volumen qpass_db_data y redeploy.
# Usá solo letras, numeros, - y _  (sin @ : / # ? %).
POSTGRES_USER=qpass
POSTGRES_PASSWORD=qpass
POSTGRES_DB=qpass

# --- Backend ---
# Minimo 16 caracteres. Ej: openssl rand -base64 32
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRA_EN=8h

# Mismo origen, no hace falta tocarlo. Se deja en "*".
CORS_ORIGEN=*

# SMTP: opcional (hoy MailService solo loguea). Dejar vacío si no se usa.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Frontend (build-time) ---
# Relativo: el front pega a /api del mismo dominio y nginx lo manda al backend.
# NO pongas una URL absoluta salvo que tengas un subdominio aparte para el API.
VITE_API_URL=/api
