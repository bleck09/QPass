generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  Admin
  Cliente
  Recargador
  Supervisor
  Devolucion
  UsuarioNormal
  UsuarioNegocio
  Ayudante
}

// Estado ACTUAL (cache) de la Entrada — se recalcula según el último RegistroIngreso:
// el más reciente tipo=ingreso sin salida después => ingresado; tipo=salida más reciente => salio.
enum EstadoIngreso {
  pendiente
  ingresado
  salio
}

enum TipoRegistroIngreso {
  ingreso
  salida
}

// Usado por Compra: aprobación del comprobante de pago.
enum EstadoSolicitud {
  pendiente
  confirmado
  rechazado
}

// Usado por SolicitudEvento: aprobación de la solicitud inicial de evento.
enum EstadoSolicitudEvento {
  pendiente
  aprobado
  rechazado
}

// Usado por Evento: pasa de activo a finalizado automáticamente cuando la fecha/hora actual
// supera fechaFin (job programado — ver comentario en el modelo Evento). Una vez finalizado,
// no se permiten más recargas, ventas, devoluciones ni ingresos/salidas de QR en ese evento.
enum EstadoEvento {
  activo
  finalizado
}

enum EstadoCaso {
  pendiente
  resuelto
}

// "venta" = crédito a la billetera (Usuario.saldo) del dueño del negocio (nace de una Venta).
// "consumo" = débito de la billetera del dueño de la Entrada escaneada (nace de una Venta).
// "recarga" = crédito a la billetera del dueño de la Entrada escaneada, hecho por un Recargador.
// "devolucion" = retiro total/parcial hecho por rol Devolucion.
// "ajuste" = corrección manual (ej. tras resolver una IncidenciaRecarga).
enum TipoTransaccion {
  recarga
  consumo
  venta
  devolucion
  ajuste
}

enum CampoReportado {
  nombre
  correo
  celular
}

// Cuentas de roles operativos (Recargador, Supervisor, Devolucion) las crea Admin directamente
// y la contraseña se manda al correo de la persona. creadoPorId audita quién creó la cuenta.
model Usuario {
  id               Int      @id @default(autoincrement())
  nombre           String
  apellidoPaterno  String?
  apellidoMaterno  String?
  email            String   @unique
  passwordHash     String
  rol              Rol
  ci               String?  @unique
  celular          String?
  fechaNacimiento  DateTime?
  ciudad           String?
  biografia        String?
  foto             String?
  saldo            Decimal  @default(0) @db.Decimal(10, 2) // cache; billetera PERSONAL, compartida
                                                            // entre todos los eventos. Fuente de
                                                            // verdad: Transaccion.usuarioId
  primerLoginEn    DateTime? // se setea en el primer login exitoso. Antes de esto, el correo
                              // (=email de esta cuenta) todavía se puede corregir vía
                              // ReporteEntrada; después queda bloqueado (ver ReporteEntrada).
  negocioAsignadoId Int?     // solo para rol=Ayudante: el ÚNICO Usuario Negocio que lo creó.
                              // Todos sus PuestoAyudante deben ser de puestos de este mismo
                              // negocio (puede trabajar en varios Puesto, pero de un solo negocio).
  creadoPorId      Int?
  createdAt        DateTime @default(now())

  creadoPor             Usuario?         @relation("CuentaCreadaPor", fields: [creadoPorId], references: [id])
  cuentasCreadas        Usuario[]        @relation("CuentaCreadaPor")
  negocioAsignado       Usuario?         @relation("AyudanteDeNegocio", fields: [negocioAsignadoId], references: [id])
  ayudantesDelNegocio   Usuario[]        @relation("AyudanteDeNegocio")
  asignaciones          Asignacion[]
  compras               Compra[]              @relation("Comprador")
  entradasPropias       Entrada[]              @relation("TitularCuenta")
  puestos               Puesto[]               @relation("NegocioDueno")
  puestosComoAyudante   PuestoAyudante[]       @relation("AyudanteAsignado")
  ayudantesCreados      PuestoAyudante[]       @relation("NegocioQueCreaAyudante")
  ventasRealizadas      Venta[]                @relation("Vendedor")
  transaccionesOperadas Transaccion[]          @relation("Operador")
  transaccionesBilletera Transaccion[]         @relation("BilleteraUsuario") // como cliente o como negocio
  incidenciasReportadas IncidenciaRecarga[]    @relation("RecargadorQueReporta")
  incidenciasResueltas  IncidenciaRecarga[]    @relation("AdminQueResuelve")
  reportesResueltos     ReporteEntrada[]       @relation("AdminQueCorrige")
  qrAsignados           CodigoQr[]             @relation("SupervisorQueAsigna")
  qrAnulados            CodigoQr[]             @relation("SupervisorQueAnula")
  registrosIngresoHechos RegistroIngreso[]     @relation("SupervisorQueRegistraIngreso")
  solicitudesEnviadas   SolicitudEvento[]      @relation("ClienteQueSolicita")
  solicitudesResueltas  SolicitudEvento[]      @relation("AdminQueResuelveSolicitud")
  eventosCreados        Evento[]               @relation("AdminQueCreaEvento")
  codigosRecuperacion   CodigoRecuperacion[]
  cambiosPassword       CambioPassword[]

  @@map("usuarios")
}

// Código de 6 dígitos para "Olvidé mi contraseña". Se invalidan los códigos previos sin usar
// de ese usuario al pedir uno nuevo, así solo el último emitido es válido.
model CodigoRecuperacion {
  id        String   @id @default(cuid())
  usuarioId Int
  codigo    String // 6 dígitos numéricos
  usado     Boolean  @default(false)
  expiraEn  DateTime
  createdAt DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("codigos_recuperacion")
}

// Auditoría de cada cambio de contraseña, para que el propio usuario (y Admin) puedan ver
// si hubo un cambio que no reconocen.
model CambioPassword {
  id        String   @id @default(cuid())
  usuarioId Int
  origen    String // 'self' (cambio normal, sabiendo la actual) | 'recuperacion' (código de 6 dígitos)
  createdAt DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("cambios_password")
}

// Un Evento se puede crear de DOS formas: (1) Admin lo crea directo, sin pasar por
// SolicitudEvento — solicitudOrigen queda null; o (2) se crea al aprobar una SolicitudEvento,
// copiando sus datos — solicitudOrigen queda con esa relación. creadoPorId es siempre el
// admin responsable (en el caso 2, normalmente el mismo que aprobó la solicitud).
// fechaFin la define el admin — cuando la fecha/hora actual la supera, un job programado pasa
// estado a "finalizado" automáticamente. Con estado=finalizado se bloquea toda operación de QR:
// recargas, ventas, devoluciones, ingreso/salida en puerta (validación en la app antes de
// cada escritura, más allá del job — por si el job aún no corrió).
model Evento {
  id          String       @id @default(cuid())
  nombre      String
  lugar       String
  fecha       DateTime
  fechaFin    DateTime
  imagen      String?
  estado      EstadoEvento @default(activo)
  qrPrefijo   String?      // 3 letras que van al inicio de cada CodigoQr.codigo generado
  qrAncho     Float?       // ancho de impresión de la manilla/QR (config del lote generado)
  qrAlto      Float?       // alto de impresión de la manilla/QR
  creadoPorId Int
  createdAt   DateTime     @default(now())

  creadoPor         Usuario      @relation("AdminQueCreaEvento", fields: [creadoPorId], references: [id])
  asignaciones      Asignacion[]
  categoriasTicket  CategoriaTicket[]
  compras           Compra[]
  entradas          Entrada[]
  codigosQr         CodigoQr[]
  puestos           Puesto[]
  transacciones     Transaccion[]
  incidenciasRecarga IncidenciaRecarga[]
  reportesEntrada    ReporteEntrada[]
  landingConfig     LandingConfig?
  solicitudOrigen   SolicitudEvento?

  @@map("eventos")
}

// Rol que cumple un usuario DENTRO de un evento específico (además de su rol global de cuenta).
model Asignacion {
  id        String   @id @default(cuid())
  eventoId  String
  usuarioId Int
  rol       Rol
  createdAt DateTime @default(now())

  evento  Evento  @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([eventoId, usuarioId])
  @@index([eventoId, rol])
  @@map("asignaciones_eventos")
}

// Solicitud que el Cliente manda ANTES de que exista el Evento (incluye lugar y fecha).
// Admin puede editar estos mismos datos antes de aprobar. Al aprobar: se crea el Evento +
// LandingConfig (copiando estos datos) y el admin arma las CategoriaTicket + el pool de CodigoQr.
// Si se rechaza, el cliente puede editar y reenviar esta misma solicitud, o crear otras nuevas.
model SolicitudEvento {
  id                String                @id @default(cuid())
  clienteId         Int
  nombreEvento      String
  lugar             String
  fecha             DateTime
  fechaFin          DateTime
  descripcion       String
  colorPrimario     String
  colorBoton        String
  colorFondo        String
  colorTextoTitulo  String
  colorTextoP       String
  imagenPortada     String?
  mapaLugar         String?               // boceto/mapa del lugar, opcional
  actividades       Json                  // [{ titulo, descripcion }]
  cronograma        Json                  // [{ hora, actividad }] — describe qué se hará a esa hora
  estado            EstadoSolicitudEvento @default(pendiente)
  motivoRechazo     String?
  eventoId          String?               @unique // se llena cuando admin aprueba y crea el Evento
  resueltoPorId     Int?
  resueltoEn        DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  cliente     Usuario  @relation("ClienteQueSolicita", fields: [clienteId], references: [id])
  resueltoPor Usuario? @relation("AdminQueResuelveSolicitud", fields: [resueltoPorId], references: [id])
  evento      Evento?  @relation(fields: [eventoId], references: [id])

  @@map("solicitudes_evento")
}

// cantidadVendida cuenta entradas de Compra en estado pendiente O confirmado (una Compra
// pendiente YA reserva el cupo, para no vender de más mientras se revisa el comprobante).
// Al rechazar una Compra, se debe decrementar cantidadVendida por sus entradas. Stock libre
// = cantidad - cantidadVendida. IMPORTANTE: incrementar cantidadVendida y crear la Compra debe
// ir en una sola transacción DB con verificación atómica (ej. UPDATE ... WHERE cantidadVendida
// + N <= cantidad), o dos compras simultáneas pueden vender la misma última entrada.
// Regla de la app: si cantidadVendida > 0, precio y cantidad quedan bloqueados (no editables).
model CategoriaTicket {
  id              String   @id @default(cuid())
  eventoId        String
  nombre          String
  descripcion     String?
  cantidad        Int
  cantidadVendida Int      @default(0)
  precio          Decimal  @db.Decimal(10, 2)
  createdAt       DateTime @default(now())

  evento   Evento    @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  entradas Entrada[]

  @@map("categorias_ticket")
}

// Una orden de compra de entradas (el titular + N invitados) hecha por un Usuario Normal.
// El pago es manual: el comprador transfiere al QR fijo de la página y sube comprobanteUrl;
// esto reserva el cupo (ver CategoriaTicket.cantidadVendida). Admin revisa en un apartado y
// confirma o rechaza (si rechaza, el cupo se libera).
model Compra {
  id                       String          @id @default(cuid())
  eventoId                 String
  compradorId              Int
  montoTotal               Decimal         @db.Decimal(10, 2)
  estado                   EstadoSolicitud @default(pendiente)
  comprobanteUrl           String?
  comprobanteNombreArchivo String?
  motivoRechazo            String?
  resueltoPorId            Int?
  resueltoEn                DateTime?
  createdAt                DateTime        @default(now())

  evento    Evento    @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  comprador Usuario   @relation("Comprador", fields: [compradorId], references: [id])
  entradas  Entrada[]

  @@index([eventoId, estado])
  @@map("compras")
}

// Cada boleto/persona dentro de una Compra. El comprador ingresa nombre/correo/celular de
// cada invitado al comprar (aún sin usuarioId). Al APROBARSE la Compra, el sistema crea (o
// vincula si el correo ya existe) una cuenta Usuario para CADA Entrada — titular e invitados
// por igual — y manda la contraseña generada a su correo. Desde ahí, esa persona tiene su
// propia billetera personal (Usuario.saldo) válida en cualquier evento, no solo este.
// El QR de manilla es independiente por evento (no por categoría) y se vincula después.
model Entrada {
  id                String        @id @default(cuid())
  eventoId          String
  compraId          String?
  categoriaTicketId String?
  usuarioId         Int?          // el titular YA lo trae desde el inicio (=compradorId, ya tiene
                                   // cuenta porque compró logueado); en invitados queda null hasta
                                   // que se les crea su cuenta al aprobarse la Compra

  isTitular Boolean @default(false)
  nombre    String
  correo    String
  celular   String?
  documento String?
  foto      String?

  estadoIngreso EstadoIngreso @default(pendiente) // cache, ver comentario en el enum

  createdAt DateTime @default(now())

  evento          Evento           @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  compra          Compra?          @relation(fields: [compraId], references: [id], onDelete: SetNull)
  categoriaTicket CategoriaTicket? @relation(fields: [categoriaTicketId], references: [id])
  usuario         Usuario?         @relation("TitularCuenta", fields: [usuarioId], references: [id])

  codigosQr         CodigoQr[] // historial: anuladas (perdida/dañada) + la activa
  transacciones     Transaccion[]
  ventas            Venta[]
  incidencias       IncidenciaRecarga[]
  reportesDatos     ReporteEntrada[]
  registrosIngreso  RegistroIngreso[] // historial completo de reingresos, cada uno con su foto

  @@index([eventoId, estadoIngreso])
  @@map("entradas")
}

// Cada escaneo de manilla en puerta: un ingreso o una salida, SIEMPRE con foto (control
// anti-préstamo de manillas entre personas). Permite reingresos ilimitados — el supervisor
// ve el historial completo, no solo el último movimiento. registradoPorId es el Supervisor
// que hizo el escaneo.
model RegistroIngreso {
  id              String              @id @default(cuid())
  entradaId       String
  tipo            TipoRegistroIngreso
  foto            String? // obligatoria solo en el primer registro de la Entrada (identifica
                           // quién retira la manilla); en los siguientes ingresos/salidas es opcional.
  registradoPorId Int
  createdAt       DateTime            @default(now())

  entrada       Entrada @relation(fields: [entradaId], references: [id], onDelete: Cascade)
  registradoPor Usuario @relation("SupervisorQueRegistraIngreso", fields: [registradoPorId], references: [id])

  @@index([entradaId, createdAt])
  @@map("registros_ingreso")
}

// Pulsera/tarjeta física con QR, del pool generado por Admin para el evento (independiente
// de la categoría de ticket). asignadoPorId/asignadoEn auditan qué Supervisor la entregó.
// Si se pierde o daña: Supervisor la anula (anulado=true, motivoAnulacion) y vincula un
// CodigoQr nuevo a la MISMA Entrada — el saldo no se mueve porque nunca vivió en el CodigoQr
// ni en la Entrada: vive en Usuario.saldo (el dueño, vía Entrada.usuarioId). El Qr es solo el
// "lector" físico que identifica a esa Entrada/persona, no el que guarda el dinero.
// entradaId ya NO es único: puede haber varias filas históricas para una misma Entrada (las
// anuladas + la activa). Regla de la app: a lo sumo UNA fila con anulado=false por entradaId.
model CodigoQr {
  id         String   @id @default(cuid())
  eventoId   String
  numero     Int
  codigo     String   @unique
  generadoEn DateTime @default(now())

  entradaId        String?
  asignadoPorId    Int?
  asignadoEn       DateTime?
  anulado          Boolean   @default(false)
  motivoAnulacion  String?   // ej. "perdida", "dañada"
  anuladoPorId     Int?
  anuladoEn        DateTime?

  evento      Evento   @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  entrada     Entrada? @relation(fields: [entradaId], references: [id])
  asignadoPor Usuario? @relation("SupervisorQueAsigna", fields: [asignadoPorId], references: [id])
  anuladoPor  Usuario? @relation("SupervisorQueAnula", fields: [anuladoPorId], references: [id])

  @@unique([eventoId, numero])
  @@index([entradaId])
  @@map("codigos_qr")
}

// Ledger único de movimientos de dinero. El dueño SIEMPRE es usuarioId (billetera personal en
// Usuario.saldo) — tanto para un cliente/invitado como para un Usuario Negocio, porque ambos
// son Usuario. entradaId es solo CONTEXTO opcional: qué manilla/evento se escaneó cuando ocurrió
// (aplica a recarga/consumo; no aplica a una venta acreditada al negocio, ni siempre a devolución).
// Una Venta genera SIEMPRE dos filas con el mismo ventaId, ambas con entradaId=la Entrada que
// compró (es solo contexto/trazabilidad, no dueño): una tipo=consumo (usuarioId=dueño de esa
// Entrada) y una tipo=venta (usuarioId=dueño del Puesto/negocio).
// eventoId queda denormalizado para: (a) validar que el operador tiene Asignacion en ESE evento,
// (b) bloquear si Evento.estado=finalizado, y (c) que los reportes financieros POR EVENTO se
// calculen sumando Transaccion filtradas por eventoId — no sirve sumar Usuario.saldo directo,
// porque esa billetera es compartida entre eventos.
model Transaccion {
  id              String          @id @default(cuid())
  eventoId        String
  tipo            TipoTransaccion
  monto           Decimal         @db.Decimal(10, 2)
  saldoResultante Decimal         @db.Decimal(10, 2) // saldo de usuarioId DESPUÉS de esta fila

  usuarioId  Int     // dueño de la billetera afectada (cliente, invitado con cuenta, o negocio)
  entradaId  String? // contexto opcional: manilla/entrada escaneada, si aplica
  ventaId    String? // set en las dos filas (consumo + venta) que genera una Venta
  operadorId Int     // quién la ejecutó: Recargador, Ayudante o Devolucion

  fotoCarnetUrl String? // exigida en retiros (Devolucion)
  nota          String?

  createdAt DateTime @default(now())

  evento   Evento   @relation(fields: [eventoId], references: [id])
  usuario  Usuario  @relation("BilleteraUsuario", fields: [usuarioId], references: [id])
  entrada  Entrada? @relation(fields: [entradaId], references: [id])
  venta    Venta?   @relation(fields: [ventaId], references: [id])
  operador Usuario  @relation("Operador", fields: [operadorId], references: [id])

  @@index([eventoId, operadorId])
  @@index([operadorId, createdAt]) // historial completo de un operador (cuadre de recarga/devolución)
  @@index([eventoId, tipo])
  @@index([usuarioId, createdAt])
  @@index([entradaId, createdAt])
  @@map("transacciones")
}

// Reporte de un Recargador cuando la recarga entregada no coincidió con lo pedido.
// Solo Admin la resuelve.
model IncidenciaRecarga {
  id              String     @id @default(cuid())
  eventoId        String     // denormalizado desde entrada.eventoId, para dashboards por evento
  entradaId       String
  montoEntregado  Decimal    @db.Decimal(10, 2)
  montoSolicitado Decimal?   @db.Decimal(10, 2)
  nota            String
  recargadorId    Int
  estado          EstadoCaso @default(pendiente)
  ajusteAplicado  Decimal?   @db.Decimal(10, 2)
  resueltoPorId   Int?
  createdAt       DateTime   @default(now())
  resueltoEn      DateTime?

  evento      Evento   @relation(fields: [eventoId], references: [id])
  entrada     Entrada  @relation(fields: [entradaId], references: [id], onDelete: Cascade)
  recargador  Usuario  @relation("RecargadorQueReporta", fields: [recargadorId], references: [id])
  resueltoPor Usuario? @relation("AdminQueResuelve", fields: [resueltoPorId], references: [id])

  @@index([eventoId, estado])
  @@map("incidencias_recarga")
}

// Reporte de un Usuario Normal: un dato (nombre/correo/celular) de una entrada ya aprobada está mal.
// Caso especial campo=correo: como el invitado necesita el correo CORRECTO para recibir su
// contraseña, es normal que reporte esto el titular en su nombre (el invitado con el correo
// mal escrito nunca pudo loguearse). Al resolver, admin corrige Entrada.correo Y Usuario.email
// juntos (son la misma cuenta) — solo permitido si Usuario.primerLoginEn sigue null; una vez
// que la persona ya inició sesión con ese correo, queda bloqueado y ya no se acepta este reporte.
model ReporteEntrada {
  id             String         @id @default(cuid())
  eventoId       String         // denormalizado desde entrada.eventoId, para dashboards por evento
  compraId       String
  entradaId      String
  campo          CampoReportado
  descripcion    String
  estado         EstadoCaso     @default(pendiente)
  valorCorregido String?
  resueltoPorId  Int?
  createdAt      DateTime       @default(now())
  resueltoEn     DateTime?

  evento      Evento   @relation(fields: [eventoId], references: [id])
  entrada     Entrada  @relation(fields: [entradaId], references: [id], onDelete: Cascade)
  resueltoPor Usuario? @relation("AdminQueCorrige", fields: [resueltoPorId], references: [id])

  @@index([eventoId, estado])
  @@map("reportes_entrada")
}

// Puesto/stand de un Usuario Negocio. Un negocio puede tener varios Puesto en el MISMO evento.
// Como los eventos no se solapan en fecha, un negocio no tiene puestos activos simultáneos
// en eventos distintos (regla validada en la app, no en la BD).
// x/y/ancho/alto los define el ADMIN (posición en el mapa del recinto), no el usuario negocio.
model Puesto {
  id           String   @id @default(cuid())
  eventoId     String
  negocioId    Int
  nombre       String
  descripcion  String?
  logo         String?
  categoria    String?
  x            Float    @default(0)
  y            Float    @default(0)
  ancho        Float    @default(100)
  alto         Float    @default(100)
  estadoActivo Boolean  @default(true)
  createdAt    DateTime @default(now())

  evento    Evento           @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  negocio   Usuario          @relation("NegocioDueno", fields: [negocioId], references: [id])
  productos Producto[]
  ayudantes PuestoAyudante[]
  ventas    Venta[]

  @@map("puestos")
}

model Producto {
  id        String   @id @default(cuid())
  puestoId  String
  nombre    String
  precio    Decimal  @db.Decimal(10, 2)
  imagen    String?
  createdAt DateTime @default(now())

  puesto     Puesto      @relation(fields: [puestoId], references: [id], onDelete: Cascade)
  ventaItems VentaItem[]

  @@map("productos")
}

// Un Ayudante puede trabajar en varios puestos a la vez, pero SIEMPRE del mismo Usuario Negocio
// (ver Usuario.negocioAsignadoId) — nunca de dos negocios distintos. creadoPorId debe ser siempre
// el negocioId del Puesto Y coincidir con Usuario.negocioAsignadoId del ayudante — se valida en
// la app al crear el registro.
model PuestoAyudante {
  id          String   @id @default(cuid())
  puestoId    String
  ayudanteId  Int
  creadoPorId Int
  turno       String   @default("Día")
  createdAt   DateTime @default(now())

  puesto    Puesto  @relation(fields: [puestoId], references: [id], onDelete: Cascade)
  ayudante  Usuario @relation("AyudanteAsignado", fields: [ayudanteId], references: [id])
  creadoPor Usuario @relation("NegocioQueCreaAyudante", fields: [creadoPorId], references: [id])

  @@unique([puestoId, ayudanteId])
  @@map("puesto_ayudantes")
}

// Una venta cobrada por un Ayudante contra el saldo del dueño de la Entrada. SIEMPRE genera dos
// Transaccion (partida doble, mismo ventaId): una tipo=consumo que debita al dueño de la Entrada,
// y una tipo=venta que acredita directo la billetera del dueño del Puesto (Usuario.saldo del
// negocio) — sin paso de confirmación intermedio.
model Venta {
  id         String   @id @default(cuid())
  puestoId   String
  ayudanteId Int
  entradaId  String
  montoTotal Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())

  puesto        Puesto        @relation(fields: [puestoId], references: [id], onDelete: Cascade)
  ayudante      Usuario       @relation("Vendedor", fields: [ayudanteId], references: [id])
  entrada       Entrada       @relation(fields: [entradaId], references: [id])
  items         VentaItem[]
  transacciones Transaccion[] // exactamente 2: una consumo (entrada) + una venta (negocio)

  @@map("ventas")
}

model VentaItem {
  id             String  @id @default(cuid())
  ventaId        String
  productoId     String
  nombreProducto String  // snapshot: el nombre puede cambiar después
  precioUnitario Decimal @db.Decimal(10, 2)
  cantidad       Int

  venta    Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [productoId], references: [id])

  @@map("venta_items")
}

// Configuración publicada de la landing pública de un evento (una por evento).
// Se crea copiando los datos de SolicitudEvento al momento en que Admin aprueba.
model LandingConfig {
  eventoId         String   @id
  titulo           String
  informacion      String
  imagen           String?
  colorPrimario    String
  colorBoton       String
  colorFondo       String
  colorTextoTitulo String
  colorTextoP      String
  actividades      Json     // [{ icono, titulo, descripcion }]
  cronograma       Json     // [{ hora, actividad }]
  updatedAt        DateTime @updatedAt

  evento Evento @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  @@map("landing_config")
}