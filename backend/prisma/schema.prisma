generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  Admin
  Cliente
  Recargador
  Supervisor
  Devolucion
  UsuarioNormal
  UsuarioNegocio
  Ayudante
}

// Estado ACTUAL (cache) de la Entrada — se recalcula según el último RegistroIngreso:
// el más reciente tipo=ingreso sin salida después => ingresado; tipo=salida más reciente => salio.
enum EstadoIngreso {
  pendiente
  ingresado
  salio
}

enum TipoRegistroIngreso {
  ingreso
  salida
}

// Usado por Compra: aprobación del comprobante de pago.
enum EstadoSolicitud {
  pendiente
  confirmado
  rechazado
}

// Usado por SolicitudEvento: aprobación de la solicitud inicial de evento.
enum EstadoSolicitudEvento {
  pendiente
  aprobado
  rechazado
}

// Usado por Evento: pasa de activo a finalizado automáticamente cuando la fecha/hora actual
// supera fechaFin (job programado — ver comentario en el modelo Evento). Una vez finalizado,
// no se permiten más recargas, ventas, devoluciones ni ingresos/salidas de QR en ese evento.
enum EstadoEvento {
  activo
  finalizado
}

// Cómo entra la gente al evento (§ control de acceso):
//   fisica  -> Admin genera un pool de códigos QR imprimibles; Supervisor
//              entrega la manilla física y la vincula a la entrada (Gestión
//              de Entrega, como hasta ahora).
//   digital -> al aprobarse la compra, la entrada recibe su código QR solo
//              (nadie lo entrega en persona); el asistente lo ve en su perfil
//              y entra mostrando ese QR desde el celular.
enum TipoManilla {
  fisica
  digital
}

// Arqueo de caja de un operador con efectivo (Recargador / Devolucion): §5.2.
enum EstadoCorteCaja {
  abierta
  cerrada
}

enum EstadoCaso {
  pendiente
  resuelto
}

// "venta" = crédito a la billetera (Usuario.saldo) del dueño del negocio (nace de una Venta).
// "consumo" = débito de la billetera del dueño de la Entrada escaneada (nace de una Venta).
// "recarga" = crédito a la billetera del dueño de la Entrada escaneada, hecho por un Recargador.
// "devolucion" = retiro total/parcial hecho por rol Devolucion.
// "ajuste" = corrección manual (ej. tras resolver una IncidenciaRecarga).
// "reverso_consumo" / "reverso_venta" = las dos filas que revierten una Venta anulada (§5.3):
//   reverso_consumo reintegra el saldo al comprador, reverso_venta se lo quita al negocio.
enum TipoTransaccion {
  recarga
  consumo
  venta
  devolucion
  ajuste
  reverso_consumo
  reverso_venta
}

enum CampoReportado {
  nombre
  correo
  celular
}

// §5.11 — motivo de una devolución (retiro de saldo). Antes era texto libre en
// Transaccion.nota; el enum permite agrupar y reportar. `otro` deja el detalle
// en `nota`.
enum MotivoDevolucion {
  retiro_efectivo
  saldo_no_usado
  error_recarga
  otro
}

// Cuentas de roles operativos (Recargador, Supervisor, Devolucion) las crea Admin directamente
// y la contraseña se manda al correo de la persona. creadoPorId audita quién creó la cuenta.
model Usuario {
  id               Int      @id @default(autoincrement())
  nombre           String
  apellidoPaterno  String?
  apellidoMaterno  String?
  email            String   @unique
  passwordHash     String
  rol              Rol
  ci               String?  @unique
  celular          String?
  fechaNacimiento  DateTime?
  ciudad           String?
  biografia        String?
  foto             String?
  // true SOLO para la cuenta que se auto-crea al aprobar una Compra (el invitado
  // recibe una contraseña temporal por correo, ver ComprasService.aprobar). Obliga
  // a pasar por /completar-perfil antes de usar el resto de la app: ahí cambia esa
  // contraseña y completa su CI (obligatorio; el resto de los campos, opcional).
  // Se pone en false solo (UsuariosService.reevaluarCompletarPerfil) una vez que
  // YA tiene ci Y ya cambió la contraseña alguna vez (CambioPassword origen=self).
  debeCompletarPerfil Boolean @default(false)
  // El saldo cashless ya NO es global: vive en BilleteraEvento, una fila por
  // (usuario, evento). El que se recarga en un evento solo sirve en ese evento.
  primerLoginEn    DateTime? // se setea en el primer login exitoso. Antes de esto, el correo
                              // (=email de esta cuenta) todavía se puede corregir vía
                              // ReporteEntrada; después queda bloqueado (ver ReporteEntrada).
  negocioAsignadoId Int?     // solo para rol=Ayudante: el ÚNICO Usuario Negocio que lo creó.
                              // Todos sus PuestoAyudante deben ser de puestos de este mismo
                              // negocio (puede trabajar en varios Puesto, pero de un solo negocio).
  creadoPorId      Int?
  createdAt        DateTime @default(now())

  creadoPor             Usuario?         @relation("CuentaCreadaPor", fields: [creadoPorId], references: [id])
  cuentasCreadas        Usuario[]        @relation("CuentaCreadaPor")
  negocioAsignado       Usuario?         @relation("AyudanteDeNegocio", fields: [negocioAsignadoId], references: [id])
  ayudantesDelNegocio   Usuario[]        @relation("AyudanteDeNegocio")
  asignaciones          Asignacion[]
  compras               Compra[]              @relation("Comprador")
  entradasPropias       Entrada[]              @relation("TitularCuenta")
  puestos               Puesto[]               @relation("NegocioDueno")
  puestosBase           PuestoBase[]           @relation("NegocioPuestoBase")
  puestosComoAyudante   PuestoAyudante[]       @relation("AyudanteAsignado")
  ayudantesCreados      PuestoAyudante[]       @relation("NegocioQueCreaAyudante")
  ventasRealizadas      Venta[]                @relation("Vendedor")
  transaccionesOperadas Transaccion[]          @relation("Operador")
  transaccionesBilletera Transaccion[]         @relation("BilleteraUsuario") // como cliente o como negocio
  incidenciasReportadas IncidenciaRecarga[]    @relation("RecargadorQueReporta")
  incidenciasResueltas  IncidenciaRecarga[]    @relation("AdminQueResuelve")
  reportesResueltos     ReporteEntrada[]       @relation("AdminQueCorrige")
  qrAsignados           CodigoQr[]             @relation("SupervisorQueAsigna")
  qrAnulados            CodigoQr[]             @relation("SupervisorQueAnula")
  registrosIngresoHechos RegistroIngreso[]     @relation("SupervisorQueRegistraIngreso")
  solicitudesEnviadas   SolicitudEvento[]      @relation("ClienteQueSolicita")
  solicitudesResueltas  SolicitudEvento[]      @relation("AdminQueResuelveSolicitud")
  eventosCreados        Evento[]               @relation("AdminQueCreaEvento")
  eventosArchivados     Evento[]               @relation("AdminQueArchivaEvento")
  eventosPublicados     Evento[]               @relation("AdminQuePublicaEvento")
  eventosComoCliente    Evento[]               @relation("ClienteDeEvento")
  codigosRecuperacion   CodigoRecuperacion[]
  cambiosPassword       CambioPassword[]
  cortesCajaComoOperador CorteCaja[]           @relation("CorteCajaOperador")
  cortesCajaCerrados     CorteCaja[]           @relation("CorteCajaCerradoPor")
  ventasAnuladas         Venta[]               @relation("VentaAnuladaPor")
  auditorias             RegistroAuditoria[]   @relation("ActorAuditoria")
  billeterasEvento       BilleteraEvento[]
  codigosRetiroNegocio   CodigoRetiroNegocio[] @relation("CodigoRetiroNegocio")

  @@map("usuarios")
}

// Código de 6 dígitos para "Olvidé mi contraseña". Se invalidan los códigos previos sin usar
// de ese usuario al pedir uno nuevo, así solo el último emitido es válido.
model CodigoRecuperacion {
  id        String   @id @default(cuid())
  usuarioId Int
  codigo    String // 6 dígitos numéricos
  usado     Boolean  @default(false)
  expiraEn  DateTime
  createdAt DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("codigos_recuperacion")
}

// Auditoría de cada cambio de contraseña, para que el propio usuario (y Admin) puedan ver
// si hubo un cambio que no reconocen.
model CambioPassword {
  id        String   @id @default(cuid())
  usuarioId Int
  origen    String // 'self' (cambio normal, sabiendo la actual) | 'recuperacion' (código de 6 dígitos)
  createdAt DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("cambios_password")
}

// Idempotencia de operaciones sensibles (recargar/consumir/venta/devolver). Ver Anexo C10.
// El cliente manda un header `Idempotency-Key` (UUID por intento). Si esa clave ya se
// procesó, IdempotenciaInterceptor devuelve la respuesta guardada sin repetir la operación.
// Un cron limpia las filas viejas (24-48hs alcanza para cubrir reintentos de red reales).
model SolicitudIdempotente {
  clave     String   @id
  respuesta Json
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("solicitudes_idempotentes")
}

// Un Evento se puede crear de DOS formas: (1) Admin lo crea directo, sin pasar por
// SolicitudEvento — solicitudOrigen queda null; o (2) se crea al aprobar una SolicitudEvento,
// copiando sus datos — solicitudOrigen queda con esa relación. creadoPorId es siempre el
// admin responsable (en el caso 2, normalmente el mismo que aprobó la solicitud).
// fechaFin la define el admin — cuando la fecha/hora actual la supera, un job programado pasa
// estado a "finalizado" automáticamente. Con estado=finalizado se bloquea toda operación de QR:
// recargas, ventas, devoluciones, ingreso/salida en puerta (validación en la app antes de
// cada escritura, más allá del job — por si el job aún no corrió).
model Evento {
  id          String       @id @default(cuid())
  nombre      String
  lugar       String
  // Pin del recinto. `coordenadas` ("lat, lng") lo sigue produciendo el
  // MapaSelector del front y es la fuente del marcador. latitud/longitud (§5.11)
  // son la versión numérica derivada, para cálculos geográficos futuros; se
  // llenan en eventos.service parseando `coordenadas`.
  coordenadas String?
  latitud     Float?
  longitud    Float?
  // Contorno del recinto dibujado por Admin sobre un mapa real (Mapa.jsx,
  // modo Contorno): array de vértices [[lat,lng], ...] del polígono. `null` =
  // sin definir todavía. Es la referencia geográfica real; el lienzo donde se
  // ubican Puesto/ElementoMapa la proyecta a un plano 2D (ver Mapa.jsx), no
  // vive acá en coordenadas de pantalla.
  contornoMapa Json?
  // §5.5 — el aforo legal es POR JORNADA (una fiesta nocturna cruza medianoche y
  // un festival tiene varias noches). Ver DiaEvento.aforoMaximo. `fecha`/`fechaFin`
  // quedan como el sobre del evento y se resincronizan al min/max de las jornadas.
  fecha       DateTime
  fechaFin    DateTime
  imagen      String?
  estado      EstadoEvento @default(activo)
  // Física (Supervisor entrega y vincula la manilla) o digital (el QR se
  // asigna solo al aprobar la compra). Ver enum TipoManilla.
  tipoManilla TipoManilla  @default(fisica)
  // Cierre DEFINITIVO: distinto de estado=finalizado (que aún permite devoluciones,
  // incidencias, reportes...). Un evento archivado queda de SOLO LECTURA — ninguna
  // escritura ligada a él pasa (ver EventoPolicy). Solo Admin archiva/desarchiva, y
  // solo un evento ya finalizado. archivadoPorId audita quién lo hizo.
  archivadoEn    DateTime?
  archivadoPorId Int?
  // Un evento nace en borrador (publicadoEn null): no aparece en el listado ni la
  // página pública, y no se pueden comprar entradas (ver EventosService/ComprasService).
  // Admin lo publica a mano desde el panel cuando ya está listo (ver requisitosPublicacion
  // en eventos.service.ts: tickets creados, QR generado, página configurada y mapa armado).
  // Los eventos que ya existían antes de esta migración quedaron publicados (ver migration.sql)
  // para no ocultar de golpe nada que ya estuviera visible/vendiendo.
  publicadoEn    DateTime?
  publicadoPorId Int?
  qrPrefijo   String?      // 3 letras que van al inicio de cada CodigoQr.codigo generado
  qrAncho     Float?       // ancho de impresión de la manilla/QR (config del lote generado)
  qrAlto      Float?       // alto de impresión de la manilla/QR
  // Días tras fechaFin en que el asistente todavía puede retirar su saldo cashless
  // (BilleteraEvento). Pasado el plazo la Devolución lo bloquea; el saldo queda
  // como dato ("saldo caducado no reclamado" en el dashboard admin).
  diasParaRetiro Int       @default(30)
  creadoPorId Int
  // Cliente organizador. Se llena al aprobar una SolicitudEvento (= SolicitudEvento.clienteId)
  // o a mano cuando Admin crea el evento directo. NULL en eventos directos sin cliente.
  // Denormaliza la Asignacion rol=Cliente que se crea en solicitudes-evento.service.aprobar.
  clienteId   Int?
  createdAt   DateTime     @default(now())

  creadoPor         Usuario      @relation("AdminQueCreaEvento", fields: [creadoPorId], references: [id])
  archivadoPor      Usuario?     @relation("AdminQueArchivaEvento", fields: [archivadoPorId], references: [id])
  publicadoPor      Usuario?     @relation("AdminQuePublicaEvento", fields: [publicadoPorId], references: [id])
  cliente           Usuario?     @relation("ClienteDeEvento", fields: [clienteId], references: [id])
  asignaciones      Asignacion[]
  categoriasTicket  CategoriaTicket[]
  compras           Compra[]
  entradas          Entrada[]
  codigosQr         CodigoQr[]
  puestos           Puesto[]
  elementosMapa     ElementoMapa[]
  transacciones     Transaccion[]
  incidenciasRecarga IncidenciaRecarga[]
  reportesEntrada    ReporteEntrada[]
  landingConfig     LandingConfig?
  solicitudOrigen   SolicitudEvento?
  resumen           ResumenEvento?
  cortesCaja        CorteCaja[]
  dias              DiaEvento[]
  billeterasEvento  BilleteraEvento[]
  codigosRetiroNegocio CodigoRetiroNegocio[]

  @@index([clienteId])
  @@map("eventos")
}

// Código QR que un Usuario Negocio presenta en Devoluciones para retirar sus
// ganancias del evento (el saldo de su BilleteraEvento). Uno por (evento,
// negocio); se auto-crea al asignar el negocio al evento. No es una manilla
// (CodigoQr), es un token de identificación del negocio para el retiro.
model CodigoRetiroNegocio {
  id        String   @id @default(cuid())
  eventoId  String
  negocioId Int
  codigo    String   @unique
  createdAt DateTime @default(now())

  evento  Evento  @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  negocio Usuario @relation("CodigoRetiroNegocio", fields: [negocioId], references: [id])

  @@unique([eventoId, negocioId])
  @@index([negocioId])
  @@map("codigos_retiro_negocio")
}

// Billetera cashless de un usuario PARA UN EVENTO (spec: el saldo recargado en un
// evento solo sirve en ese evento). Reemplaza al viejo Usuario.saldo global. La
// fuente de verdad sigue siendo el ledger (Transaccion filtrada por
// usuarioId + eventoId); esta fila es el saldo vivo, actualizado en la misma
// transacción que cada movimiento (ver TransaccionesService).
model BilleteraEvento {
  id        String    @id @default(cuid())
  usuarioId Int
  eventoId  String
  saldo     Decimal   @default(0) @db.Decimal(10, 2)
  // §5.10 — parte del saldo retenida por una IncidenciaRecarga pendiente: NO se
  // puede gastar/retirar (el débito guarda contra `saldo - saldoBloqueado`).
  // Se libera al resolver la incidencia.
  saldoBloqueado Decimal @default(0) @db.Decimal(10, 2)
  expiraEn  DateTime? // Fase 3: fin de la última jornada + Evento.diasParaRetiro
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  evento  Evento  @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, eventoId])
  @@index([eventoId])
  @@map("billeteras_evento")
}

// Una "jornada" del evento: bloque con inicio/fin propios (una fiesta nocturna
// va de 20:00 a 02:00 cruzando medianoche; un festival tiene varias). Todo lo
// que hoy colgaba del evento entero cuelga de acá: categoría de ticket, entrada,
// manilla (CodigoQr) y aforo. Un evento de una sola noche tiene 1 DiaEvento
// (se auto-crea con el evento).
model DiaEvento {
  id          String   @id @default(cuid())
  eventoId    String
  nombre      String?  // "Noche de apertura" — opcional; la UI muestra "Día N" si es null
  inicio      DateTime
  fin         DateTime
  orden       Int
  aforoMaximo Int?     // §5.5 — capacidad legal de ESTA jornada
  createdAt   DateTime @default(now())

  evento     Evento            @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  categorias CategoriaTicket[]
  entradas   Entrada[]
  codigosQr  CodigoQr[]

  @@index([eventoId, orden])
  @@map("dias_evento")
}

// Arqueo de caja de un operador con efectivo, por evento (§5.2). Se abre al
// empezar el turno y se cierra declarando el efectivo contado; el sistema
// calcula lo que debería haber (fondo inicial ± Σ transacciones del operador
// en la ventana) y la diferencia. Un solo abierto por (operador, evento)
// -> índice parcial en la migración.
model CorteCaja {
  id             String          @id @default(cuid())
  eventoId       String
  operadorId     Int
  rol            Rol // Recargador | Devolucion (denormalizado del operador)
  estado         EstadoCorteCaja @default(abierta)
  montoInicial   Decimal         @default(0) @db.Decimal(10, 2)
  abiertaEn      DateTime        @default(now())
  cerradaEn      DateTime?
  montoSistema   Decimal?        @db.Decimal(10, 2)
  montoEsperado  Decimal?        @db.Decimal(10, 2)
  montoDeclarado Decimal?        @db.Decimal(10, 2)
  diferencia     Decimal?        @db.Decimal(10, 2)
  observacion    String?
  cerradaPorId   Int?

  evento        Evento        @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  operador      Usuario       @relation("CorteCajaOperador", fields: [operadorId], references: [id])
  cerradaPor    Usuario?      @relation("CorteCajaCerradoPor", fields: [cerradaPorId], references: [id])
  transacciones Transaccion[]

  @@index([eventoId, rol])
  @@index([operadorId, abiertaEn])
  @@map("cortes_caja")
}

// Foto inmutable de los números del evento, generada al ARCHIVARLO (que es
// cuando dejan de entrar escrituras — ver EventoPolicy). El dashboard histórico
// y el informe de cierre leen de acá para no recalcular sobre tablas vivas
// (spec 5.7). Se borra al desarchivar, y así se vuelve a calcular en vivo.
model ResumenEvento {
  eventoId         String   @id
  entradasVendidas Int
  asistentes       Int
  recaudado        Decimal  @db.Decimal(10, 2)
  recargado        Decimal  @db.Decimal(10, 2)
  consumido        Decimal  @db.Decimal(10, 2)
  devuelto         Decimal  @db.Decimal(10, 2)
  saldoRemanente   Decimal  @db.Decimal(10, 2)
  generadoEn       DateTime @default(now())

  evento Evento @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  @@map("resumenes_evento")
}

// Rol que cumple un usuario DENTRO de un evento específico (además de su rol global de cuenta).
model Asignacion {
  id        String   @id @default(cuid())
  eventoId  String
  usuarioId Int
  rol       Rol
  createdAt DateTime @default(now())

  evento  Evento  @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([eventoId, usuarioId])
  @@index([eventoId, rol])
  @@map("asignaciones_eventos")
}

// Solicitud que el Cliente manda ANTES de que exista el Evento (incluye lugar y fecha).
// Admin puede editar estos mismos datos antes de aprobar. Al aprobar: se crea el Evento +
// LandingConfig (copiando estos datos) y el admin arma las CategoriaTicket + el pool de CodigoQr.
// Si se rechaza, el cliente puede editar y reenviar esta misma solicitud, o crear otras nuevas.
model SolicitudEvento {
  id                String                @id @default(cuid())
  clienteId         Int
  nombreEvento      String
  lugar             String
  fecha             DateTime
  fechaFin          DateTime
  descripcion       String
  aforoEstimado     Int?                  // §5.11 — asistentes que el cliente estima; al aprobar pasa a Evento.aforoMaximo
  colorPrimario     String
  colorBoton        String
  colorFondo        String
  colorTextoTitulo  String
  colorTextoP       String
  imagenPortada     String?
  mapaLugar         String?               // boceto/mapa del lugar, opcional
  actividades       Json                  // [{ titulo, descripcion }]
  cronograma        Json                  // [{ hora, actividad }] — describe qué se hará a esa hora
  estado            EstadoSolicitudEvento @default(pendiente)
  motivoRechazo     String?
  eventoId          String?               @unique // se llena cuando admin aprueba y crea el Evento
  resueltoPorId     Int?
  resueltoEn        DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  cliente     Usuario  @relation("ClienteQueSolicita", fields: [clienteId], references: [id])
  resueltoPor Usuario? @relation("AdminQueResuelveSolicitud", fields: [resueltoPorId], references: [id])
  evento      Evento?  @relation(fields: [eventoId], references: [id])

  @@map("solicitudes_evento")
}

// cantidadVendida cuenta entradas de Compra en estado pendiente O confirmado (una Compra
// pendiente YA reserva el cupo, para no vender de más mientras se revisa el comprobante).
// Al rechazar una Compra, se debe decrementar cantidadVendida por sus entradas. Stock libre
// = cantidad - cantidadVendida. IMPORTANTE: incrementar cantidadVendida y crear la Compra debe
// ir en una sola transacción DB con verificación atómica (ej. UPDATE ... WHERE cantidadVendida
// + N <= cantidad), o dos compras simultáneas pueden vender la misma última entrada.
// Regla de la app: si cantidadVendida > 0, precio y cantidad quedan bloqueados (no editables).
model CategoriaTicket {
  id              String   @id @default(cuid())
  eventoId        String
  diaEventoId     String   // toda categoría pertenece a una jornada (ver DiaEvento)
  nombre          String
  // Lista de beneficios/features de esta categoría (una fila por línea, ej.
  // "Baño compartido", "Acceso a zona VIP") — se muestran como bullets en la
  // landing pública (ver App.jsx). Reemplaza a la vieja `descripcion` única
  // (un solo texto largo, "se hacía un chorizo" en el card).
  beneficios      String[] @default([])
  cantidad        Int
  cantidadVendida Int      @default(0)
  precio          Decimal  @db.Decimal(10, 2)
  createdAt       DateTime @default(now())

  evento    Evento    @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  diaEvento DiaEvento @relation(fields: [diaEventoId], references: [id], onDelete: Cascade)
  entradas  Entrada[]

  @@index([eventoId])
  @@index([diaEventoId])
  @@map("categorias_ticket")
}

// Una orden de compra de entradas (el titular + N invitados) hecha por un Usuario Normal.
// El pago es manual: el comprador transfiere al QR fijo de la página y sube comprobanteUrl;
// esto reserva el cupo (ver CategoriaTicket.cantidadVendida). Admin revisa en un apartado y
// confirma o rechaza (si rechaza, el cupo se libera).
model Compra {
  id                       String          @id @default(cuid())
  eventoId                 String
  compradorId              Int
  montoTotal               Decimal         @db.Decimal(10, 2)
  estado                   EstadoSolicitud @default(pendiente)
  comprobanteUrl           String?
  comprobanteNombreArchivo String?
  motivoRechazo            String?
  resueltoPorId            Int?
  resueltoEn                DateTime?
  // §T&C — el comprador aceptó los términos al crear la compra.
  terminosAceptadosEn      DateTime?
  versionTerminos          String?
  createdAt                DateTime        @default(now())

  evento    Evento    @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  comprador Usuario   @relation("Comprador", fields: [compradorId], references: [id])
  entradas  Entrada[]

  @@index([eventoId, estado])
  @@index([compradorId])
  @@map("compras")
}

// Cada boleto/persona dentro de una Compra. El comprador ingresa nombre/correo/celular de
// cada invitado al comprar (aún sin usuarioId). Al APROBARSE la Compra, el sistema crea (o
// vincula si el correo ya existe) una cuenta Usuario para CADA Entrada — titular e invitados
// por igual — y manda la contraseña generada a su correo. Desde ahí, esa persona tiene su
// propia billetera personal (Usuario.saldo) válida en cualquier evento, no solo este.
// El QR de manilla es independiente por evento (no por categoría) y se vincula después.
model Entrada {
  id                String        @id @default(cuid())
  eventoId          String
  diaEventoId       String?       // jornada de esta entrada (hereda de la categoría). Nullable por robustez.
  compraId          String?
  categoriaTicketId String?
  usuarioId         Int?          // el titular YA lo trae desde el inicio (=compradorId, ya tiene
                                   // cuenta porque compró logueado); en invitados queda null hasta
                                   // que se les crea su cuenta al aprobarse la Compra

  isTitular Boolean @default(false)
  numero    Int?          // correlativo por evento, legible para el asistente ("entrada N.º 42").
                           // Se asigna de forma atómica al APROBARSE la Compra (antes de eso la
                           // Entrada solo reserva cupo y todavía no "cuenta" como asistente real).
  nombre    String
  correo    String
  celular   String?
  documento String?
  foto      String?

  estadoIngreso EstadoIngreso @default(pendiente) // cache, ver comentario en el enum

  createdAt DateTime @default(now())

  evento          Evento           @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  diaEvento       DiaEvento?       @relation(fields: [diaEventoId], references: [id], onDelete: SetNull)
  compra          Compra?          @relation(fields: [compraId], references: [id], onDelete: SetNull)
  categoriaTicket CategoriaTicket? @relation(fields: [categoriaTicketId], references: [id])
  usuario         Usuario?         @relation("TitularCuenta", fields: [usuarioId], references: [id])

  codigosQr         CodigoQr[] // historial: anuladas (perdida/dañada) + la activa
  transacciones     Transaccion[]
  ventas            Venta[]
  incidencias       IncidenciaRecarga[]
  reportesDatos     ReporteEntrada[]
  registrosIngreso  RegistroIngreso[] // historial completo de reingresos, cada uno con su foto

  @@unique([eventoId, numero])
  @@index([eventoId, estadoIngreso])
  @@index([diaEventoId, estadoIngreso]) // aforo por jornada
  @@index([usuarioId]) // "mis entradas" del invitado: se buscan por Entrada.usuarioId
  @@map("entradas")
}

// Cada escaneo de manilla en puerta: un ingreso o una salida, SIEMPRE con foto (control
// anti-préstamo de manillas entre personas). Permite reingresos ilimitados — el supervisor
// ve el historial completo, no solo el último movimiento. registradoPorId es el Supervisor
// que hizo el escaneo.
model RegistroIngreso {
  id              String              @id @default(cuid())
  entradaId       String
  tipo            TipoRegistroIngreso
  foto            String? // copia histórica de la foto tomada en ESTE movimiento puntual, para
                           // el historial de auditoría. La foto de referencia vigente vive en
                           // Entrada.foto (una sola por persona-evento, ver entradas.routes.js).
  registradoPorId Int
  createdAt       DateTime            @default(now())

  entrada       Entrada @relation(fields: [entradaId], references: [id], onDelete: Cascade)
  registradoPor Usuario @relation("SupervisorQueRegistraIngreso", fields: [registradoPorId], references: [id])

  @@index([entradaId, createdAt])
  @@map("registros_ingreso")
}

// Pulsera/tarjeta física con QR, del pool generado por Admin para el evento (independiente
// de la categoría de ticket). asignadoPorId/asignadoEn auditan qué Supervisor la entregó.
// Si se pierde o daña: Supervisor la anula (anulado=true, motivoAnulacion) y vincula un
// CodigoQr nuevo a la MISMA Entrada — el saldo no se mueve porque nunca vivió en el CodigoQr
// ni en la Entrada: vive en Usuario.saldo (el dueño, vía Entrada.usuarioId). El Qr es solo el
// "lector" físico que identifica a esa Entrada/persona, no el que guarda el dinero.
// entradaId ya NO es único: puede haber varias filas históricas para una misma Entrada (las
// anuladas + la activa). Regla de la app: a lo sumo UNA fila con anulado=false por entradaId.
model CodigoQr {
  id          String   @id @default(cuid())
  eventoId    String
  diaEventoId String?  // jornada de la manilla. El pool se genera a nivel evento (sin
                       // jornada) y la manilla la ADOPTA de la entrada al vincularse
                       // (entradas.service.vincularQr). Null hasta entonces.
  numero      Int
  codigo      String   @unique
  generadoEn  DateTime @default(now())

  entradaId        String?
  asignadoPorId    Int?
  asignadoEn       DateTime?
  anulado          Boolean   @default(false)
  motivoAnulacion  String?   // ej. "perdida", "dañada"
  anuladoPorId     Int?
  anuladoEn        DateTime?

  evento      Evento     @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  diaEvento   DiaEvento? @relation(fields: [diaEventoId], references: [id], onDelete: SetNull)
  entrada     Entrada?   @relation(fields: [entradaId], references: [id])
  asignadoPor Usuario?   @relation("SupervisorQueAsigna", fields: [asignadoPorId], references: [id])
  anuladoPor  Usuario?   @relation("SupervisorQueAnula", fields: [anuladoPorId], references: [id])

  @@unique([eventoId, numero])
  @@index([entradaId])
  @@index([eventoId, anulado])
  @@index([eventoId, diaEventoId])
  @@map("codigos_qr")
}

// Ledger único de movimientos de dinero. El dueño SIEMPRE es usuarioId (billetera personal en
// Usuario.saldo) — tanto para un cliente/invitado como para un Usuario Negocio, porque ambos
// son Usuario. entradaId es solo CONTEXTO opcional: qué manilla/evento se escaneó cuando ocurrió
// (aplica a recarga/consumo; no aplica a una venta acreditada al negocio, ni siempre a devolución).
// Una Venta genera SIEMPRE dos filas con el mismo ventaId, ambas con entradaId=la Entrada que
// compró (es solo contexto/trazabilidad, no dueño): una tipo=consumo (usuarioId=dueño de esa
// Entrada) y una tipo=venta (usuarioId=dueño del Puesto/negocio).
// eventoId queda denormalizado para: (a) validar que el operador tiene Asignacion en ESE evento,
// (b) bloquear si Evento.estado=finalizado, y (c) que los reportes financieros POR EVENTO se
// calculen sumando Transaccion filtradas por eventoId — no sirve sumar Usuario.saldo directo,
// porque esa billetera es compartida entre eventos.
model Transaccion {
  id              String          @id @default(cuid())
  eventoId        String
  tipo            TipoTransaccion
  monto           Decimal         @db.Decimal(10, 2)
  saldoResultante Decimal         @db.Decimal(10, 2) // saldo de usuarioId DESPUÉS de esta fila

  usuarioId  Int     // dueño de la billetera afectada (cliente, invitado con cuenta, o negocio)
  entradaId  String? // contexto opcional: manilla/entrada escaneada, si aplica
  ventaId    String? // set en las dos filas (consumo + venta) que genera una Venta
  operadorId Int     // quién la ejecutó: Recargador, Ayudante o Devolucion
  // §5.2 — caja de efectivo a la que pertenece este movimiento. Se estampa en
  // recarga (Recargador) y devolucion (Devolucion): el arqueo cuadra sumando
  // por corteCajaId, no por ventana de tiempo. NULL en ventas/consumos/ajustes
  // y en recargas hechas por Admin (correcciones, fuera de turno).
  corteCajaId String?

  fotoCarnetUrl    String?           // exigida en retiros (Devolucion): foto del carnet de quien cobra
  fotoRostroUrl    String?           // foto de la cara de quien cobra — obligatoria en el retiro de un negocio
  motivoDevolucion MotivoDevolucion? // §5.11 — solo en filas tipo=devolucion
  nota             String?

  createdAt DateTime @default(now())

  evento    Evento     @relation(fields: [eventoId], references: [id])
  usuario   Usuario    @relation("BilleteraUsuario", fields: [usuarioId], references: [id])
  entrada   Entrada?   @relation(fields: [entradaId], references: [id])
  venta     Venta?     @relation(fields: [ventaId], references: [id])
  operador  Usuario    @relation("Operador", fields: [operadorId], references: [id])
  corteCaja CorteCaja? @relation(fields: [corteCajaId], references: [id])

  @@index([eventoId, operadorId])
  @@index([operadorId, createdAt]) // historial completo de un operador (cuadre de recarga/devolución)
  @@index([eventoId, tipo])
  @@index([usuarioId, createdAt])
  @@index([entradaId, createdAt])
  @@index([corteCajaId])
  @@map("transacciones")
}

// Reporte de un Recargador cuando la recarga entregada no coincidió con lo pedido.
// Solo Admin la resuelve.
model IncidenciaRecarga {
  id              String     @id @default(cuid())
  eventoId        String     // denormalizado desde entrada.eventoId, para dashboards por evento
  entradaId       String
  montoEntregado  Decimal    @db.Decimal(10, 2)
  montoSolicitado Decimal?   @db.Decimal(10, 2)
  nota            String
  recargadorId    Int
  estado          EstadoCaso @default(pendiente)
  // Parte del saldo del titular que quedó retenida al abrir la incidencia
  // (cuando se le cargó de más). Se libera al resolver. 0 si no hubo retención.
  montoBloqueado  Decimal    @default(0) @db.Decimal(10, 2)
  // Ajuste aplicado al saldo al resolver: >0 acredita (se le debía), <0 descuenta
  // (se le cargó de más), 0 sin movimiento. Antes solo permitía >= 0.
  ajusteAplicado  Decimal?   @db.Decimal(10, 2)
  resueltoPorId   Int?
  createdAt       DateTime   @default(now())
  resueltoEn      DateTime?

  evento      Evento   @relation(fields: [eventoId], references: [id])
  entrada     Entrada  @relation(fields: [entradaId], references: [id], onDelete: Cascade)
  recargador  Usuario  @relation("RecargadorQueReporta", fields: [recargadorId], references: [id])
  resueltoPor Usuario? @relation("AdminQueResuelve", fields: [resueltoPorId], references: [id])

  @@index([eventoId, estado])
  @@map("incidencias_recarga")
}

// Reporte de un Usuario Normal: un dato (nombre/correo/celular) de una entrada ya aprobada está mal.
// Caso especial campo=correo: como el invitado necesita el correo CORRECTO para recibir su
// contraseña, es normal que reporte esto el titular en su nombre (el invitado con el correo
// mal escrito nunca pudo loguearse). Al resolver, admin corrige Entrada.correo Y Usuario.email
// juntos (son la misma cuenta) — solo permitido si Usuario.primerLoginEn sigue null; una vez
// que la persona ya inició sesión con ese correo, queda bloqueado y ya no se acepta este reporte.
model ReporteEntrada {
  id             String         @id @default(cuid())
  eventoId       String         // denormalizado desde entrada.eventoId, para dashboards por evento
  compraId       String
  entradaId      String
  campo          CampoReportado
  descripcion    String
  estado         EstadoCaso     @default(pendiente)
  valorCorregido String?
  resueltoPorId  Int?
  createdAt      DateTime       @default(now())
  resueltoEn     DateTime?

  evento      Evento   @relation(fields: [eventoId], references: [id])
  entrada     Entrada  @relation(fields: [entradaId], references: [id], onDelete: Cascade)
  resueltoPor Usuario? @relation("AdminQueCorrige", fields: [resueltoPorId], references: [id])

  @@index([eventoId, estado])
  @@map("reportes_entrada")
}

// Catálogo del negocio definido UNA sola vez, reutilizable entre eventos.
// El negocio crea sus PuestoBase (nombre + logo + catálogo) y luego los "activa"
// en cada evento — cada activación crea un Puesto (abajo) que apunta acá.
model PuestoBase {
  id          String   @id @default(cuid())
  negocioId   Int
  nombre      String
  descripcion String?
  logo        String?
  categoria   String?
  archivado   Boolean  @default(false)
  createdAt   DateTime @default(now())

  negocio   Usuario        @relation("NegocioPuestoBase", fields: [negocioId], references: [id])
  productos ProductoBase[]
  puestos   Puesto[]

  @@index([negocioId])
  @@map("puestos_base")
}

model ProductoBase {
  id           String   @id @default(cuid())
  puestoBaseId String
  nombre       String
  precio       Decimal  @db.Decimal(10, 2) // precio por defecto; cada evento puede sobrescribirlo
  imagen       String?
  categoria    String?  // §5.11 — "bebida" | "comida" | ... para agrupar ventas
  archivado    Boolean  @default(false)    // no se borra si ya tiene VentaItem
  createdAt    DateTime @default(now())

  puestoBase PuestoBase       @relation(fields: [puestoBaseId], references: [id], onDelete: Cascade)
  estados    ProductoEstado[]
  ventaItems VentaItem[]

  @@index([puestoBaseId])
  @@map("productos_base")
}

// Estado local de un ProductoBase dentro de un Puesto (evento). Se crea una fila
// por producto al activar el puesto en el evento.
//   activo=false => no se puede vender en ESE evento (sin tocar el base).
//   stock null   => sin control de inventario; si es número, cada venta lo
//                   decrementa (guardado) y una anulación lo restituye.
//   precio null  => usa ProductoBase.precio; si tiene valor, lo sobrescribe.
model ProductoEstado {
  id             String   @id @default(cuid())
  puestoId       String
  productoBaseId String
  activo         Boolean  @default(true)
  stock          Int?
  precio         Decimal? @db.Decimal(10, 2)

  puesto       Puesto       @relation(fields: [puestoId], references: [id], onDelete: Cascade)
  productoBase ProductoBase @relation(fields: [productoBaseId], references: [id], onDelete: Cascade)

  @@unique([puestoId, productoBaseId])
  @@index([puestoId])
  @@map("productos_estado")
}

// Aviso que manda un Ayudante al Usuario Negocio cuando un producto de su puesto
// se quedó sin stock o está por agotarse (§5.4). Campos denormalizados para
// mostrarlo sin joins. `visto` lo marca el negocio desde su panel.
model AvisoStock {
  id             String   @id @default(cuid())
  puestoId       String
  productoBaseId String
  productoNombre String
  puestoNombre   String
  eventoNombre   String
  ayudanteId     Int
  ayudanteNombre String
  negocioId      Int
  tipo           String // "sin_stock" | "bajo"
  stockRestante  Int?
  visto          Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([negocioId, visto])
  @@map("avisos_stock")
}

// Activación de un PuestoBase en un evento concreto. Un negocio puede activar
// varios PuestoBase distintos en el MISMO evento, pero cada base a lo sumo una vez.
// Como los eventos no se solapan en fecha, un negocio no tiene puestos activos
// simultáneos en eventos distintos (regla validada en la app, no en la BD).
// x/y/ancho/alto los define el ADMIN (posición en el mapa del recinto).
// nombre/logo/catálogo se leen del PuestoBase.
model Puesto {
  id           String   @id @default(cuid())
  eventoId     String
  negocioId    Int
  puestoBaseId String
  x            Float    @default(0)
  y            Float    @default(0)
  ancho        Float    @default(100)
  alto         Float    @default(100)
  estadoActivo Boolean  @default(true)
  createdAt    DateTime @default(now())

  evento          Evento           @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  negocio         Usuario          @relation("NegocioDueno", fields: [negocioId], references: [id])
  base            PuestoBase       @relation(fields: [puestoBaseId], references: [id])
  productosEstado ProductoEstado[]
  ayudantes       PuestoAyudante[]
  ventas          Venta[]

  @@unique([eventoId, puestoBaseId])
  @@index([eventoId])
  @@index([negocioId, eventoId])
  @@map("puestos")
}

// Cuadro del plano que NO es un negocio (Puesto): catálogo fijo de zonas del
// recinto (entrada, baños, escenario, recargador, supervisor...). A diferencia
// de Puesto, lo crea y borra directamente el Admin desde Mapa.jsx — no hay
// ventas ni catálogo detrás, así que sí se puede eliminar de verdad.
model ElementoMapa {
  id        String           @id @default(cuid())
  eventoId  String
  tipo      TipoElementoMapa
  nombre    String
  x         Float            @default(0)
  y         Float            @default(0)
  ancho     Float            @default(100)
  alto      Float            @default(100)
  createdAt DateTime         @default(now())

  evento Evento @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  @@index([eventoId])
  @@map("elementos_mapa")
}

enum TipoElementoMapa {
  entrada
  banos
  escenario
  recargador
  supervisor
  otro
}

// Un Ayudante puede trabajar en varios puestos a la vez, pero SIEMPRE del mismo Usuario Negocio
// (ver Usuario.negocioAsignadoId) — nunca de dos negocios distintos. creadoPorId debe ser siempre
// el negocioId del Puesto Y coincidir con Usuario.negocioAsignadoId del ayudante — se valida en
// la app al crear el registro.
model PuestoAyudante {
  id          String   @id @default(cuid())
  puestoId    String
  ayudanteId  Int
  creadoPorId Int
  turno       String   @default("Día")
  createdAt   DateTime @default(now())

  puesto    Puesto  @relation(fields: [puestoId], references: [id], onDelete: Cascade)
  ayudante  Usuario @relation("AyudanteAsignado", fields: [ayudanteId], references: [id])
  creadoPor Usuario @relation("NegocioQueCreaAyudante", fields: [creadoPorId], references: [id])

  @@unique([puestoId, ayudanteId])
  @@map("puesto_ayudantes")
}

// Una venta cobrada por un Ayudante contra el saldo del dueño de la Entrada. SIEMPRE genera dos
// Transaccion (partida doble, mismo ventaId): una tipo=consumo que debita al dueño de la Entrada,
// y una tipo=venta que acredita directo la billetera del dueño del Puesto (Usuario.saldo del
// negocio) — sin paso de confirmación intermedio.
model Venta {
  id         String   @id @default(cuid())
  puestoId   String
  ayudanteId Int
  entradaId  String
  montoTotal Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())

  // Anulación (§5.3): al anular se generan 2 Transaccion de reverso con el mismo
  // ventaId. anuladaEn != null => la venta no cuenta en los dashboards (neto).
  anuladaEn       DateTime?
  anuladaPorId    Int?
  motivoAnulacion String?

  puesto        Puesto        @relation(fields: [puestoId], references: [id], onDelete: Restrict)
  ayudante      Usuario       @relation("Vendedor", fields: [ayudanteId], references: [id])
  entrada       Entrada       @relation(fields: [entradaId], references: [id])
  anuladaPor    Usuario?      @relation("VentaAnuladaPor", fields: [anuladaPorId], references: [id])
  items         VentaItem[]
  transacciones Transaccion[] // 2 al crear (consumo + venta); +2 al anular (reverso_*)

  @@index([puestoId, createdAt])
  @@index([ayudanteId, createdAt])
  @@index([entradaId])
  @@index([anuladaEn])
  @@map("ventas")
}

model VentaItem {
  id             String  @id @default(cuid())
  ventaId        String
  productoBaseId String
  nombreProducto String  // snapshot: el nombre puede cambiar después
  precioUnitario Decimal @db.Decimal(10, 2) // snapshot: incluye el override del evento
  cantidad       Int

  venta        Venta        @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  productoBase ProductoBase @relation(fields: [productoBaseId], references: [id])

  @@index([ventaId])
  @@index([productoBaseId])
  @@map("venta_items")
}

// Configuración publicada de la landing pública de un evento (una por evento).
// Se crea copiando los datos de SolicitudEvento al momento en que Admin aprueba.
model LandingConfig {
  eventoId         String   @id
  titulo           String
  informacion      String
  imagen           String?
  colorPrimario    String
  colorBoton       String
  colorFondo       String
  colorTextoTitulo String
  colorTextoP      String
  actividades      Json     // [{ icono, titulo, descripcion }]
  cronograma       Json     // [{ hora, actividad }]
  updatedAt        DateTime @updatedAt

  evento Evento @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  @@map("landing_config")
}
// Registro de auditoría de las escrituras sensibles (§5.8): quién hizo qué, con
// el antes y el después. Se escribe fire-and-forget (nunca rompe la operación).
// entidad/accion son String a propósito: la lista crece y no queremos migrar
// cada vez que se audita algo nuevo.
model RegistroAuditoria {
  id        String   @id @default(cuid())
  actorId   Int
  entidad   String   // 'compra' | 'incidencia_recarga' | 'reporte_entrada' | 'evento' | 'solicitud_evento' | 'venta' | 'corte_caja'
  entidadId String
  accion    String   // 'aprobar' | 'rechazar' | 'resolver' | 'corregir' | 'actualizar' | 'archivar' | 'desarchivar' | 'publicar' | 'despublicar' | 'cerrar' | 'anular'
  antes     Json?
  despues   Json?
  createdAt DateTime @default(now())

  actor Usuario @relation("ActorAuditoria", fields: [actorId], references: [id])

  @@index([entidad, entidadId])
  @@index([actorId])
  @@index([createdAt])
  @@map("registros_auditoria")
}
