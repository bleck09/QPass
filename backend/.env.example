# === Conexión a PostgreSQL ===
# Coincide con docker-compose.yml (postgres expuesto en el puerto 5433).
# Misma BD que el backend Express de ../backend: este backend la reemplaza.
DATABASE_URL="postgresql://qpass:qpass@localhost:5433/qpass?schema=public"

# === Redis — usado solo por BullMQ (colas de correo, ver C11). Opcional hoy. ===
REDIS_URL="redis://localhost:6379"

# === Autenticación ===
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRA_EN="8h"

# === Correo saliente (SMTP). Si SMTP_HOST queda vacío, MailService cae al
# modo stub (solo loguea, no envía) — útil para desarrollo local sin cuenta. ===
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# === Pasarela de pagos Libélula. Sin LIBELULA_APPKEY, el canal "pagar en
# línea" queda deshabilitado y solo se usa el pago manual con comprobante. ===
LIBELULA_APPKEY=""
LIBELULA_API_URL="https://api.libelula.bo"
LIBELULA_CALLBACK_URL=""
LIBELULA_URL_RETORNO=""

# === Almacenamiento de imágenes (MinIO local, ver docker-compose.yml) ===
# En producción el backend habla con el contenedor "minio" por la red interna
# (S3_ENDPOINT lo fija ../docker-compose.yml). Acá se apunta al MinIO local.
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="qpass-uploads"
S3_ACCESS_KEY="qpass-minio"
S3_SECRET_KEY="qpass-minio-secret"
S3_REGION="us-east-1"
S3_FORCE_PATH_STYLE="true"

# === Servidor ===
# PORT 4000: es el valor por defecto que espera frontend/src/api/client.js (VITE_API_URL).
PORT="4000"
# Origen permitido para CORS. Debe coincidir con la URL del frontend (Vite dev = 5173).
# Vacío o "*" => se permiten todos los orígenes (como hacía el backend Express anterior).
CORS_ORIGEN="http://localhost:5173"

NODE_ENV="development"
