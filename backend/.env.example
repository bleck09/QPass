# === Conexión a PostgreSQL ===
# Coincide con docker-compose.yml (postgres expuesto en el puerto 5433).
# Misma BD que el backend Express de ../backend: este backend la reemplaza.
DATABASE_URL="postgresql://qpass:qpass@localhost:5433/qpass?schema=public"

# === Redis — usado solo por BullMQ (colas de correo, ver C11). Opcional hoy. ===
REDIS_URL="redis://localhost:6379"

# === Autenticación ===
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRA_EN="8h"

# === Correo saliente (SMTP). Hoy MailService solo loguea; no envía. ===
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# === Servidor ===
# PORT 4000: es el valor por defecto que espera frontend/src/api/client.js (VITE_API_URL).
PORT="4000"
# Origen permitido para CORS. Debe coincidir con la URL del frontend (Vite dev = 5173).
# Vacío o "*" => se permiten todos los orígenes (como hacía el backend Express anterior).
CORS_ORIGEN="http://localhost:5173"

NODE_ENV="development"
